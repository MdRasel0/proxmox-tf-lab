###############################################################################
# LAB 6 (optional) — pull IPs from NetBox instead of hardcoding them
#
# To enable:
#   1. mv 03-netbox.tf.disabled 03-netbox.tf
#   2. add the netbox provider to providers.tf (snippet below)
#   3. export TF_VAR_netbox_token='...'
#   4. terraform init    # pulls the new provider
#
# Add to providers.tf required_providers:
#
#   netbox = {
#     source  = "e-breuninger/netbox"
#     version = "~> 3.9"
#   }
#
# And the provider block:
#
#   provider "netbox" {
#     server_url = var.netbox_url
#     api_token  = var.netbox_token
#   }
###############################################################################

variable "netbox_url" {
  description = "NetBox base URL, e.g. https://netbox.internal"
  type        = string
  default     = ""
}

variable "netbox_token" {
  description = "NetBox API token"
  type        = string
  sensitive   = true
  default     = ""
}

variable "netbox_prefix" {
  description = "Prefix to allocate service IPs from"
  type        = string
  default     = "10.0.10.0/24"
}

# Look up the prefix that IPs should come from.
data "netbox_prefix" "mgmt" {
  cidr = var.netbox_prefix
}

# Claim the next free IP per service. This is a RESOURCE, not a data source —
# it actually reserves the address in NetBox and records it in tfstate.
resource "netbox_available_ip_address" "svc" {
  count = length(local.services)

  prefix_id   = data.netbox_prefix.mgmt.id
  status      = "active"
  dns_name    = "${local.services[count.index]}-01.internal"
  description = "Allocated by Terraform (bdNOG lab)"
}

# Then in 02-services.tf, replace the hardcoded address with:
#
#   ip_config {
#     ipv4 {
#       address = netbox_available_ip_address.svc[count.index].ip_address
#       gateway = cidrhost(data.netbox_prefix.mgmt.cidr, 1)
#     }
#   }
#
# ip_address comes back already in CIDR form ("10.0.10.11/24"), which is
# exactly what Proxmox cloud-init expects.
#
# CAUTION:
#  - terraform destroy RELEASES these IPs back to NetBox.
#  - Allocating many at once has historically produced duplicates in this
#    provider. Test it, and consider -parallelism=1 for large applies.

output "netbox_allocated_ips" {
  description = "IPs claimed from NetBox"
  value       = [for ip in netbox_available_ip_address.svc : ip.ip_address]
}
