# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# Better still, pass secrets by environment instead:
#   export TF_VAR_pve_api_token='terraform@pve!provider=xxxxxxxx-....'

pve_endpoint = "https://pve1.internal:8006/"
pve_insecure = true
pve_node     = "pve1"

datastore = "local-lvm"
bridge    = "vmbr0"
vlan_id   = null          # e.g. 20 if you tag

template_vm_id = 9000

ip_base     = "10.0.10"
ip_offset   = 11
subnet_cidr = "24"
gateway     = "10.0.10.1"

ssh_public_key = "ssh-ed25519 AAAAC3Nza... you@workstation"

# pve_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
