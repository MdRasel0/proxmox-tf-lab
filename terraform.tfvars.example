# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
# Secrets go in environment variables instead:
#   $env:TF_VAR_pve_endpoint   = 'https://pve1.internal:8006/'
#   $env:TF_VAR_pve_api_token  = 'terraform@pve!provider=xxxxxxxx-....'
#   $env:TF_VAR_netbox_url     = 'https://netbox.internal'
#   $env:TF_VAR_netbox_token   = '...'
#   $env:TF_VAR_ssh_public_key = Get-Content $env:USERPROFILE\.ssh\id_ed25519.pub -Raw
#   $env:PG_CONN_STR           = 'postgres://user:pass@host:5432/tfstate'

pve_insecure   = true
pve_node       = "pve1"
template_vm_id = 9000
datastore      = "local-lvm"
bridge         = "vmbr0"
vlan_id        = null # e.g. 20 if you tag

netbox_insecure     = true
netbox_cluster_name = "pve-cluster"
netbox_prefix       = "172.16.212.0/23"

gateway     = "172.16.212.1"
dns_domain  = "internal"
dns_servers = ["1.1.1.1", "8.8.8.8"]
